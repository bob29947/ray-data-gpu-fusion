+    def _release_idle_actors_if_complete(self) -> None:
+        if (
+            not self._release_idle_actors_on_completion
+            or not self._inputs_complete
+            or self._bundle_queue.num_blocks() != 0
+            or self._block_ref_bundler.estimate_size_bytes() != 0
+        ):
+            return
+
+        current_size = self._actor_pool.current_size()
+        if current_size:
+            # Pool downscaling only removes pending or idle actors. Active actors
+            # remain until their completion callback invokes this method again.
