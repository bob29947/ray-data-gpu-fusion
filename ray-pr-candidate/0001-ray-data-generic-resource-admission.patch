diff --git a/python/ray/data/_internal/execution/resource_admission.py b/python/ray/data/_internal/execution/resource_admission.py
new file mode 100644
index 0000000000..38c9deddc6
--- /dev/null
+++ b/python/ray/data/_internal/execution/resource_admission.py
@@ -0,0 +1,86 @@
+from __future__ import annotations
+
+import enum
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Optional, Tuple
+
+if TYPE_CHECKING:
+    from ray.data._internal.execution.interfaces.execution_options import (
+        ExecutionResources,
+    )
+
+
+RESOURCE_ADMISSION_CONTROL_VERSION = 1
+
+
+class AdmissionKind(enum.Enum):
+    ELASTIC_POOL = "elastic_pool"
+    FIXED_GANG = "fixed_gang"
+
+
+class ResourceAdmissionState(enum.Enum):
+    DORMANT = "dormant"
+    ADMITTED = "admitted"
+    FRONTIER = "frontier"
+    BLOCKED = "blocked"
+
+
+@dataclass(frozen=True)
+class AdmissionBundle:
+    resources: ExecutionResources
+    custom_resources: Tuple[Tuple[str, float], ...] = ()
+    label_selector: Tuple[Tuple[str, str], ...] = ()
+
+
+@dataclass(frozen=True)
+class ResourceAdmissionSpec:
+    kind: AdmissionKind
+    minimum_bundles: Tuple[AdmissionBundle, ...]
+    unit_bundle: Optional[AdmissionBundle]
+    max_units: Optional[int]
+    sticky_after_start: bool
+
+
+@dataclass(frozen=True)
+class ResourceAdmissionGrant:
+    max_units: int
+
+
+def aggregate_minimum_resources(
+    spec: ResourceAdmissionSpec,
+) -> ExecutionResources:
+    from ray.data._internal.execution.interfaces.execution_options import (
+        ExecutionResources,
+    )
+
+    return ExecutionResources.combine_sum(
+        bundle.resources for bundle in spec.minimum_bundles
+    )
+
+
+def validate_resource_admission_spec(spec: ResourceAdmissionSpec) -> None:
+    if not spec.minimum_bundles:
+        raise ValueError("Resource admission requires at least one minimum bundle")
+    if spec.max_units is not None and spec.max_units <= 0:
+        raise ValueError("Resource admission max_units must be positive")
+    if spec.kind is not AdmissionKind.FIXED_GANG and spec.unit_bundle is None:
+        raise ValueError(f"{spec.kind.value} resource admission requires a unit bundle")
+
+    bundles = list(spec.minimum_bundles)
+    if spec.unit_bundle is not None:
+        bundles.append(spec.unit_bundle)
